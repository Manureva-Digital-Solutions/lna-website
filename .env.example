# Outbound email — Google Workspace SMTP relay (no provider account, no API keys).
# Auth is by source IP (set in Admin console → Gmail → Routing → SMTP relay service).
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
# EHLO greeting name — must be an FQDN (Google rejects bare hostnames with 421)
SMTP_NAME=lnaflow.com
# Bind outbound to this source IP (the relay IP-allowlist is IPv4-only)
SMTP_LOCAL_ADDRESS=
# Only set these if the relay requires SMTP AUTH; leave unset for IP-based auth.
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=noreply@lnaflow.com
SMTP_FROM_NAME=LNA
CONTACT_INBOX=hello@lnaflow.com

# Live Chat — Crisp
NEXT_PUBLIC_CRISP_WEBSITE_ID=

# Analytics — Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Canonical site origin (defaults to https://lnaflow.com when unset)
# MUST be overridden on staging (https://staging.lnaflow.com) — it is inlined at
# `next build`, so changing it requires a rebuild, not just a process restart.
NEXT_PUBLIC_SITE_URL=https://lnaflow.com

# Product app origin used by the sign-in / register links (defaults to
# https://app.lnaflow.com when unset). On staging, set this to
# https://staging.lna.manurevasolutions.com or testers land on the LIVE app.
NEXT_PUBLIC_APP_URL=https://app.lnaflow.com

# Form rate limit — /api/demo-request and /api/newsletter (anti email abuse).
# Both routes send mail, so they are throttled per client IP and per route
# BEFORE anything reaches SMTP. Exceeding the limit returns HTTP 429 with a
# `Retry-After` header (seconds) and body { "error": "rate_limited" }.
# The defaults below apply when the variables are unset — do NOT set them just to
# turn the limit on. Non-numeric, zero or negative values fall back to the
# default (a bad value can never disable the limiter).
# The counter lives in the Node process, which is correct because the site runs
# as ONE Node process (pm2 `lna-vitrine` in production, one systemd unit on
# staging). If it is ever run with several Node instances, this must move to a
# shared store — see docs/ops/form-rate-limit.md.
# Client IP: nginx appends the real peer to X-Forwarded-For
# (`proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;`), so the
# RIGHTMOST entry is used (X-Real-IP wins when present). A spoofed leftmost
# entry is ignored; requests with no IP at all share one "unknown" bucket.
# RATE_LIMIT_MAX=5
# RATE_LIMIT_WINDOW_MS=60000
